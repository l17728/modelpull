# modelpull controller image — v2.1 single-host docker deploy.
#
# Multi-stage: build with uv (lockfile drives a deterministic install),
# run with a slim python image. Matches the pattern in Dockerfile.executor.
FROM python:3.12-slim AS builder
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.9
COPY pyproject.toml uv.lock alembic.ini ./
COPY src/ src/
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/alembic.ini ./alembic.ini
COPY config/ ./config/
# MANUAL.md is read at request time by /api/v1/help/manual (the UI Docs
# drawer); copy it into the image so the in-app help works out of the box.
COPY MANUAL.md ./MANUAL.md
COPY docs/operator/ ./docs/operator/
# curl: for healthcheck + ad-hoc troubleshooting from `docker exec`
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONPATH=/app/src

EXPOSE 8001

# Default to uvicorn but allow overriding ENTRYPOINT for migrations etc.
CMD ["uvicorn", "dlw.main:app", "--host", "0.0.0.0", "--port", "8001"]

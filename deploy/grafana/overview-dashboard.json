{
  "title": "DLW — Overview",
  "uid": "dlw-overview",
  "tags": ["dlw"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "label": "Datasource",
        "hide": 0
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(dlw_tasks_active_count, tenant_id)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "🚦 系统体征红绿灯（OPS-V21-06, v2.0.17）",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 101,
      "title": "Controller role",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 1 },
      "targets": [{"expr": "max(dlw_controller_role) by (role)", "legendFormat": "{{role}}"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"1": {"text": "ACTIVE", "color": "green"}, "0": {"text": "STANDBY", "color": "blue"}}}
          ]
        }
      }
    },
    {
      "id": 102,
      "title": "PG replication lag",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 1 },
      "targets": [{"expr": "max(pg_replication_lag_seconds)"}],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}
        }
      }
    },
    {
      "id": 103,
      "title": "WSS conn %",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 1 },
      "targets": [{"expr": "100 * sum(dlw_executor_ws_connected) / count(dlw_executor_status == 1)"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 80}, {"color": "green", "value": 95}]}
        }
      }
    },
    {
      "id": 104,
      "title": "Probe leader",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 1 },
      "targets": [{"expr": "dlw_rate_limit_probe_leader_present"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "NO LEADER", "color": "red"}, "1": {"text": "ELECTED", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 105,
      "title": "Active P0/P1 alerts",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 1 },
      "targets": [{"expr": "count(ALERTS{severity=~\"page|work-hours\", alertstate=\"firing\"})"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}
        }
      }
    },
    {
      "id": 106,
      "title": "Recovery in progress?",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 1 },
      "targets": [{"expr": "max(dlw_controller_recovery_in_progress)"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "RECOVERING (503)", "color": "red"}}}
          ]
        }
      }
    },
    {
      "id": 107,
      "title": "Audit chain integrity",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 1 },
      "targets": [{"expr": "max(dlw_audit_chain_integrity)"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "BROKEN ⚠️", "color": "red"}, "1": {"text": "OK", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 108,
      "title": "Last DataIntegrity (24h)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 21, "y": 1 },
      "targets": [{"expr": "increase(dlw_subtask_retries_total{reason=\"checksum\"}[24h])"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 1,
      "title": "Active tasks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(dlw_tasks_active_count{tenant_id=~\"$tenant\"})",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Tasks completed (7d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(dlw_tasks_completed_total{status=\"completed\"}[7d]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasks failed (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(dlw_tasks_completed_total{status=\"failed\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Healthy executors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "count(dlw_executor_health_score >= 70)",
          "legendFormat": "healthy"
        }
      ]
    },
    {
      "id": 5,
      "title": "API SLO (30d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "avg_over_time(dlw:api_availability:ratio_rate5m[30d]) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Bytes downloaded / sec (cluster)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (source_id) (rate(dlw_chunk_download_bytes_total[5m]))",
          "legendFormat": "{{source_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "links": [
            {
              "title": "🔗 View in Loki: this source's logs",
              "url": "/explore?left={\"datasource\":\"Loki\",\"queries\":[{\"expr\":\"{component=\\\"hf_proxy\\\",source_id=\\\"${__field.labels.source_id}\\\"}\"}]}",
              "targetBlank": true
            }
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Source health",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "dlw:source_health:by_id",
          "legendFormat": "{{source_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "short" }
      }
    },
    {
      "id": 8,
      "title": "Task duration P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(dlw_task_duration_seconds_bucket[1h])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(dlw_task_duration_seconds_bucket[1h])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(dlw_task_duration_seconds_bucket[1h])))", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 9,
      "title": "Subtask retries by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(dlw_subtask_retries_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Executor health score (top 20)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "topk(20, dlw_executor_health_score)",
          "format": "table"
        }
      ]
    }
  ]
}

# modelpull v2.1 single-host deployment — environment variables.
#
# Copy this to .env and fill in. The bootstrap.sh script will generate
# the required secrets if they're missing — running bootstrap.sh is the
# safest way to populate this file the first time.
#
# DO NOT commit .env to git. The .gitignore already excludes it.

# ---- PostgreSQL ----------------------------------------------------------
# pick a strong password; only the docker network sees PG, but still
POSTGRES_PASSWORD=changeme-strong-password

# ---- MinIO (S3-compatible storage) --------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-strong-minio-password

# ---- Controller auth ----------------------------------------------------
# JWT signing secret (32+ chars). bootstrap.sh generates a random one.
DLW_SYSTEM_JWT_SECRET=replace-with-32-byte-random

# Local admin (username/password login). bootstrap.sh generates this
# unless you set it explicitly.
DLW_ADMIN_USERNAME=admin
DLW_ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password

# Enrollment token — executors present this to /executors/join.
# bootstrap.sh generates a random 32-byte token.
DLW_ENROLLMENT_TOKEN=replace-with-32-byte-enrollment-token

# ---- Optional: dev mode -------------------------------------------------
# Set to "true" ONLY for tinkering on a sealed test machine — it lets
# any holder of DLW_SYSTEM_JWT_SECRET mint a system_admin JWT without
# the normal flow. For catown.cloud production-shape: leave unset.
# DLW_AUTH_DEV_MODE=true

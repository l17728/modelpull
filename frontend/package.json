  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.1",
